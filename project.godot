; Engine configuration file.
; Godot 4.x project file for Shellstrike2D

config_version=5

[application]

config/name="Shellstrike2D"
config/description="Top-down 2D tactical shooter: Tortoises vs Rabbits"
run/main_scene="res://scenes/MainMenu.tscn"
config/features=PackedStringArray("4.3", "Mobile")
boot_splash/bg_color=Color(0.07, 0.09, 0.07, 1)

[autoload]

Global="*res://scripts/global.gd"
GameManager="*res://scripts/game_manager.gd"
TouchInput="*res://scripts/touch_input.gd"
SkinManager="*res://scripts/skin_manager.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/handheld/orientation="portrait"
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

